# Copiá este archivo como .env y completá los valores.

# Contraseña para entrar al panel (OBLIGATORIA, usá una larga)
ADMIN_PASSWORD=cambiar-por-una-clave-larga

# Puerto y dirección donde escucha el panel.
# 127.0.0.1 = sólo accesible localmente (cloudflared se conecta ahí). No lo expongas directo.
PORT=3000
HOST=127.0.0.1

# Zona horaria para el horario de envío y el límite diario
TZ_CAMPAIGN=America/Argentina/Cordoba

# Opcional: ruta a Chrome/Chromium si puppeteer no trae el suyo (ej. /usr/bin/chromium)
# CHROME_PATH=/usr/bin/chromium

# Opcional: carpetas de datos
# DATA_DIR=./data
# WWEBJS_AUTH_DIR=./.wwebjs_auth
